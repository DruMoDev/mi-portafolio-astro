{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dru-portfolio",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-01-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Envío del formulario de contacto con Cloudflare Email Routing.
  // CONTACT_TO (el Gmail verificado como destino) se añade como secreto:
  //   npx wrangler secret put CONTACT_TO
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Analítica de redes para /api/social: el Worker de tiktok-editor, por service binding.
  // El token de lectura se añade como secreto:
  //   npx wrangler secret put DFORGE_ANALYTICS_TOKEN
  "services": [{ "binding": "DFORGE", "service": "dforge-api" }],
  "vars": {
    "CONTACT_FROM": "web@drumorera.com",
  },
  // drumorera.com y www apuntan a este Worker (antes, al proyecto Pages mi-portafolio-astro).
  "routes": [
    { "pattern": "drumorera.com", "custom_domain": true },
    { "pattern": "www.drumorera.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
