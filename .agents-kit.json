{
  "changelog": false,
  "setup": "scripts/preparar-entorno.sh",
  "contenido": [
    "docs/superpowers/",
    "src/content/guias/"
  ],
  "protegido": [
    "migrations/",
    "wrangler.jsonc"
  ],
  "verificar": {
    "rapido": "npm run format:check && npm run test",
    "completo": "npm run format:check && npm run type-check && npm run test && npm run build && npm run lint && npm run typecheck"
  },
  "lint": {
    "fichero": {
      "ts,tsx,mts,cts,js,jsx,mjs,cjs,astro": "KIT_LINT_RAPIDO=1 node_modules/.bin/eslint --cache --cache-location node_modules/.cache/agents-kit/eslint-rapido --no-warn-ignored --pass-on-unpruned-suppressions"
    },
    "turno": "bash .agents-kit/turno.sh"
  }
}
