<script>
  import { formatCount } from "../lib/social";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const faces = [...document.querySelectorAll<HTMLElement>(".face[data-loop]")];
  const obj = faces[0]?.parentElement;
  let timers: number[] = [];
  let playing: HTMLElement | null = null;
  let visible = true;
  const cycles = new Map<HTMLElement, number>();

  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
  const stop = () => {
    timers.forEach(clearTimeout);
    timers = [];
    playing = null;
  };
  const els = (face: HTMLElement, sel: string) => [...face.querySelectorAll<HTMLElement>(sel)];

  function slots(face: HTMLElement): Record<string, string> {
    if (!face.dataset.cycle) return {};
    const list = JSON.parse(face.dataset.cycle) as Record<string, string>[];
    const k = cycles.get(face) ?? 0;
    cycles.set(face, (k + 1) % list.length);
    return list[k];
  }

  const target = (el: HTMLElement, words: Record<string, string>) =>
    el.dataset.slot ? (words[el.dataset.slot] ?? "") : (el.dataset.type ?? "");

  const count = (el: HTMLElement) =>
    `${formatCount(Number(el.dataset.count))}${el.dataset.suffix ?? ""}`;

  // Escena terminada y quieta (movimiento reducido).
  function still(face: HTMLElement) {
    const words = slots(face);
    face.classList.add("done");
    els(face, "[data-at]").forEach((el) => el.classList.toggle("show", !el.dataset.out));
    els(face, "[data-slot]").forEach((el) => (el.textContent = target(el, words)));
    els(face, "[data-type]").forEach((el) => (el.textContent = target(el, words)));
    els(face, "[data-count]").forEach((el) => (el.textContent = count(el)));
  }

  function play(face: HTMLElement, delay: number) {
    stop();
    playing = face;
    if (reduce.matches) return still(face);
    const words = slots(face);
    face.classList.remove("done", "rewind");
    els(face, ".show").forEach((el) => el.classList.remove("show"));
    els(face, "[data-slot]:not([data-type])").forEach((el) => (el.textContent = target(el, words)));
    els(face, "[data-type]").forEach((el) => (el.textContent = ""));
    els(face, "[data-count]").forEach(
      (el) =>
        (el.textContent = el.dataset.from
          ? formatCount(Number(el.dataset.from))
          : `0${el.dataset.suffix ?? ""}`)
    );
    // Los contadores sin `data-at` cuentan desde el principio.
    els(face, "[data-count]:not([data-at])").forEach((el) => countUp(el, delay + 200));

    els(face, "[data-at]").forEach((el) => {
      const at = delay + Number(el.dataset.at);
      later(() => {
        el.classList.add("show");
        if (el.hasAttribute("data-type")) typeIn(el, target(el, words));
      }, at);
      if (el.dataset.count) countUp(el, at);
      if (el.dataset.out) later(() => el.classList.remove("show"), delay + Number(el.dataset.out));
    });

    const loop = delay + Number(face.dataset.loop);
    later(() => face.classList.add("rewind"), loop);
    later(() => play(face, 250), loop + 450);
  }

  function typeIn(el: HTMLElement, text: string) {
    [...text].forEach((_, k) => later(() => (el.textContent = text.slice(0, k + 1)), k * 42));
  }

  function countUp(el: HTMLElement, at: number) {
    const to = Number(el.dataset.count);
    const from = Number(el.dataset.from ?? 0);
    const steps = 24;
    for (let k = 1; k <= steps; k++) {
      const v = from + (to - from) * (1 - (1 - k / steps) ** 3);
      later(() => (el.textContent = `${formatCount(v)}${el.dataset.suffix ?? ""}`), at + k * 45);
    }
  }

  function sync() {
    const on = faces.find((f) => f.classList.contains("on"));
    if (!on || !visible) return stop();
    // Espera a que el objeto termine de cambiar de forma.
    if (on !== playing) play(on, 650);
  }

  faces.forEach((f) =>
    new MutationObserver(sync).observe(f, { attributes: true, attributeFilter: ["class"] })
  );
  // Solo anima mientras se ve.
  if (obj) {
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!visible) stop();
      sync();
    }).observe(obj);
  }
  reduce.addEventListener("change", () => {
    stop();
    sync();
  });
</script>

<style>
  .face {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    overflow: hidden;
  }
  .face.on {
    opacity: 1;
    transition: opacity 0.45s 0.55s;
  }
  /* Fin de la vuelta: todo se desvanece un instante y empieza otra vez. */
  .face [data-at] {
    transition:
      opacity 0.4s,
      transform 0.55s var(--spring);
  }
  .face.rewind [data-at],
  .face.rewind .r-progress i {
    opacity: 0 !important;
    transition: opacity 0.35s !important;
  }

  /* ───── Automatizaciones: el chat que contesta solo ───── */
