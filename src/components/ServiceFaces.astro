    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 38px 14px 12px;
    background: #008069;
    color: #fff;
    font-size: 14px;
  }
  .wa-top b {
    display: block;
    font-weight: 600;
  }
  .wa-av {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    color: #008069;
  }
  .status {
    font-size: 11px;
    opacity: 0.85;
  }
  .typing-txt {
    display: none;
  }
  .wa:has(.dots.show) .online {
    display: none;
  }
  .wa:has(.dots.show) .typing-txt {
    display: inline;
  }
  .wa-body {
    position: absolute;
    inset: 82px 0 0;
    padding: 12px;
    background: #efeae2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .msg {
    max-width: 82%;
    max-height: 0;
    margin-top: 0;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.35;
    opacity: 0;
    overflow: hidden;
    transform: translateY(10px) scale(0.96);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
    transition:
      max-height 0.45s var(--ease),
      padding 0.45s var(--ease),
      margin 0.45s var(--ease),
      opacity 0.3s,
      transform 0.45s var(--spring) !important;
  }
  .msg.show {
    max-height: 120px;
    margin-top: 8px;
    padding: 7px 10px;
    opacity: 1;
    transform: none;
  }
  .msg.c {
    align-self: flex-end;
    background: #d9fdd3;
    transform-origin: bottom right;
  }
  .msg.b {
    align-self: flex-start;
    background: #fff;
    transform-origin: bottom left;
  }
  .msg i {
    display: block;
    text-align: right;
    font-style: normal;
    font-size: 10px;
    color: #53bdeb;
    margin-top: 2px;
  }
  .msg small {
    display: block;
    font-size: 10px;
    color: #667781;
    margin-top: 2px;
  }
  .dots {
    display: flex;
    gap: 4px;
  }
  .dots.show {
    padding: 11px 12px;
  }
  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9aa5ab;
    animation: blink 1s infinite;
  }
  .dots span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dots span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
      transform: translateY(-2px);
    }
  }
  .toast {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    z-index: 2;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
    font-size: 12px;
    color: var(--soft);
    opacity: 0;
    transform: translateY(-120%);
  }
  .toast.t2 {
    top: 66px;
  }
  .toast.show {
    opacity: 1;
    transform: none;
  }
  .toast b {
