---
import Icon from "./Icon.astro";
import { getPublicConfig } from "../lib/config";

interface Props {
  showVideos: boolean;
}

const { showVideos } = Astro.props;
const cfg = getPublicConfig();
---

<header class="wrap">
  <a class="brand" href="/" aria-label="Dru Morera, inicio">
    <span class="mark" aria-hidden="true">D</span>
    <span>Dru Morera</span>
  </a>
  <nav aria-label="Principal">
    <div class="links">
      <a href="#servicios">Servicios</a>
      {showVideos && <a href="#videos">Vídeos</a>}
      <a href="#contacto">Contacto</a>
    </div>
    {
      cfg.whatsappUrl && (
        <a
          class="icon-btn"
          href={cfg.whatsappUrl}
          target="_blank"
          rel="noopener"
          aria-label="Escríbeme por WhatsApp (se abre en otra pestaña)"
        >
          <Icon name="whatsapp" size={18} />
        </a>
      )
    }
    <a href="#contacto" class="btn-sm" data-open>
      Contactar
      <Icon name="right" size={16} />
    </a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    font-size: 15px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .mark {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.4s var(--spring);
  }
  .brand:hover .mark {
    transform: rotate(-8deg) scale(1.06);
  }
  nav {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .links {
    display: flex;
    padding: 4px;
    border-radius: 999px;
    background: var(--tint);
    margin-right: 6px;
  }
  .links a {
    padding: 7px 14px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--soft);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .links a:hover {
    color: var(--ink);
    background: #fff;
  }
  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .icon-btn:hover {
    background: #25d366;
    color: #fff;
    box-shadow: none;
  }
  .btn-sm {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #fff;
    background: var(--ink);
    padding: 10px 14px 10px 18px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-sm :global(svg) {
    transition: transform 0.25s var(--spring);
  }
  .btn-sm:hover {
    background: var(--accent);
  }
  .btn-sm:hover :global(svg) {
    transform: translateX(3px);
  }
  @media (max-width: 980px) {
    .links {
      display: none;
    }
  }
</style>
