---
interface Props {
  showVideos: boolean;
}

const { showVideos } = Astro.props;
---

<header class="wrap">
  <a class="brand" href="/">Dru Morera</a>
  <nav aria-label="Principal">
    <a href="#servicios">Servicios</a>
    {showVideos && <a href="#videos">Vídeos</a>}
    <a href="#contacto" class="btn-sm" data-open>Contactar</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
    font-size: 15px;
  }
  .brand {
    font-weight: 650;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  nav a {
    text-decoration: none;
    color: var(--soft);
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav .btn-sm {
    color: #fff;
    background: var(--ink);
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }
  nav .btn-sm:hover {
    color: #fff;
    background: var(--accent);
  }
  @media (max-width: 980px) {
    nav a:not(.btn-sm) {
      display: none;
    }
  }
</style>
