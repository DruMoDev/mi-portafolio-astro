---
import Icon from "./Icon.astro";
import { formatCount, formatViews, getSocial, networkNames, publicSocial } from "../lib/social";

// Lo guardado en el build (`npm run social:sync`). Al cargar, /api/social lo refresca.
const social = publicSocial(getSocial())!;

// Degradados de reserva para vídeos sin miniatura.
const G = [
  "linear-gradient(165deg,#2440FF,#0B1240)",
  "linear-gradient(165deg,#1E1E24,#4A4A55)",
  "linear-gradient(165deg,#0E7A57,#0B2A22)",
  "linear-gradient(165deg,#8A5CF6,#2A1660)",
  "linear-gradient(165deg,#E0562E,#4A1A0B)",
  "linear-gradient(165deg,#3A8DDE,#0D2742)",
  "linear-gradient(165deg,#C2A27A,#4A3622)",
  "linear-gradient(165deg,#D23C77,#3D0B22)",
];

const ringSets = [
  { key: "top", label: "Más vistos", icon: "flame" as const, videos: social.top },
  { key: "latest", label: "Últimos", icon: "clock" as const, videos: social.latest },
].filter((s) => s.videos.length);
---

<section class="videos" id="videos" aria-labelledby="videos-t" data-updated={social.updatedAt}>
  <div class="videos-head">
    <div>
      <h2 class="sec" id="videos-t">Lo cuento en vídeo</h2>
      <div class="stats">
        <p>
          <b data-followers>+{formatCount(social.followers)}</b>
          <span>personas me siguen en <span data-followed-on>{social.followedOn}</span></span>
        </p>
        <p>
          <b data-views>{formatViews(social.views)}</b>
          <span>visualizaciones de mis vídeos</span>
        </p>
      </div>
    </div>
    {
      ringSets.length > 1 && (
        <div class="seg" role="group" aria-label="Qué vídeos ver">
          <span class="seg-pill" aria-hidden="true" />
          {ringSets.map((s, i) => (
            <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-set={s.key}>
              <Icon name={s.icon} size={18} />
              {s.label}
            </button>
          ))}
        </div>
      )
    }
  </div>

  <div class="ring-wrap" role="region" aria-label="Vídeos destacados. Arrastra para girar.">
    {
      ringSets.map((set, si) => (
        <div class="ring" data-ring={set.key} hidden={si !== 0}>
          {set.videos.map((v, k) => (
            <a
              class="card"
              href={v.url}
              target="_blank"
              rel="noopener"
              draggable="false"
              style={`--a:${(k * 360) / set.videos.length}deg;--g:${G[k % G.length]}`}
              aria-label={`${v.title}, en ${networkNames[v.network]}, ${formatViews(v.views)} visualizaciones (se abre en otra pestaña)`}
            >
              <img
                class="thumb"
                src={v.thumbnail ?? ""}
                hidden={!v.thumbnail}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
                referrerpolicy="no-referrer"
              />
              <span class="net">{networkNames[v.network]}</span>
              <span>
                <span class="ttl">{v.title}</span>
                <span class="views">
                  <Icon name="eye" size={16} />
                  <span data-v>{formatViews(v.views)}</span>
                </span>
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="ring-ctrl">
    <button type="button" class="round" data-spin="1" aria-label="Girar a la izquierda">
      <Icon name="left" />
    </button>
    <button type="button" class="round" data-spin="-1" aria-label="Girar a la derecha">
      <Icon name="right" />
    </button>
  </div>
</section>

<script>
  import {
    formatCount,
    formatViews,
    networkNames,
    type PublicSocial,
    type Video,
  } from "../lib/social";

  const section = document.getElementById("videos");
  const wrap = section?.querySelector<HTMLElement>(".ring-wrap");
  if (section && wrap) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const rings = [...wrap.querySelectorAll<HTMLElement>(".ring")];
    // Grados por milisegundo del giro automático: una vuelta cada 30 s, sin pararse nunca.
    const AUTO = 360 / 30_000;
    let ring = rings[0];
    let ry = 0;
    let vel = 0;
    let dragging = false;
    let moved = 0;
    let lastX = 0;
    let visible = true;
    let frame = 0;
    let last = 0;

    const cards = () => [...ring.querySelectorAll<HTMLElement>(".card")];

    // Radio del anillo según el número de tarjetas, para que no se solapen.
    function layout() {
      const n = cards().length;
      const w = ring.offsetWidth || 210;
      const base = innerWidth < 700 ? 270 : 380;
      const min = w / 2 / Math.tan(Math.PI / n) + 24;
      rings.forEach((r) => r.style.setProperty("--z", `${Math.round(Math.max(base, min))}px`));
    }

    function tick(now: number) {
      const dt = last ? Math.min(now - last, 50) : 16;
      last = now;
      if (!dragging) {
        ry += vel;
        vel *= 0.94;
        if (!reduce.matches) ry -= AUTO * dt;
      }
      ring.style.setProperty("--ry", `${ry}deg`);
      const list = cards();
      const step = 360 / list.length;
      const front = Math.round((((-ry % 360) + 360) % 360) / step) % list.length;
      list.forEach((c, k) => {
        c.classList.toggle("front", k === front);
        // Las de detrás se ocultan: Chrome deja ver un filo de su borde aunque estén de espaldas.
        const angle = (((k * step + ry) % 360) + 360) % 360;
        c.classList.toggle("back", angle > 100 && angle < 260);
      });
      frame = visible ? requestAnimationFrame(tick) : 0;
    }

    // Solo anima mientras se ve: ahorra batería, no ata nada al scroll.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) {
        last = 0;
        frame = requestAnimationFrame(tick);
      }
    }).observe(wrap);

    wrap.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = 0;
      lastX = e.clientX;
      vel = 0;
    });
    addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      moved += Math.abs(dx);
      ry += dx * 0.3;
      vel = dx * 0.3;
      lastX = e.clientX;
    });
    addEventListener("pointerup", () => (dragging = false));
    addEventListener("pointercancel", () => (dragging = false));
    // Un arrastre no debe abrir el vídeo.
    // (detail 0 = Enter desde el teclado, que siempre abre).
    wrap.addEventListener("click", (e) => {
      if (e.detail !== 0 && moved > 6) e.preventDefault();
      moved = 0;
    });
    // Al tabular, gira hasta la tarjeta con el foco.
    wrap.addEventListener("focusin", (e) => {
      const k = cards().indexOf((e.target as HTMLElement).closest(".card")!);
      if (k >= 0) {
        vel = 0;
        ry = (-k * 360) / cards().length;
      }
    });

    section.querySelectorAll<HTMLButtonElement>("[data-spin]").forEach((b) =>
      b.addEventListener("click", () => {
        const dir = Number(b.dataset.spin);
        if (reduce.matches) ry += (dir * 360) / cards().length;
        else vel = dir * 3.2;
      })
    );

    const seg = section.querySelector<HTMLElement>(".seg");
    const segPill = seg?.querySelector<HTMLElement>(".seg-pill");
    const segButtons = [...section.querySelectorAll<HTMLButtonElement>(".seg button")];
    function placeSegPill() {
      const on = segButtons.find((b) => b.getAttribute("aria-pressed") === "true");
      if (!on || !segPill) return;
      segPill.style.left = `${on.offsetLeft}px`;
      segPill.style.width = `${on.offsetWidth}px`;
    }
    segButtons.forEach((b) =>
      b.addEventListener("click", () => {
        const next = rings.find((r) => r.dataset.ring === b.dataset.set);
        if (!next || next === ring) return;
        segButtons.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
        placeSegPill();
        ring.hidden = true;
        next.hidden = false;
        ring = next;
        layout();
        cards().forEach((c, k) => {
          c.classList.remove("swap");
          void c.offsetWidth;
          c.style.animationDelay = `${k * 40}ms`;
          c.classList.add("swap");
        });
      })
    );

    // Refresca con la analítica del momento. Si falla, se queda lo guardado en el build.
    function fill(card: HTMLAnchorElement, v: Video) {
      card.href = v.url;
      card.setAttribute(
        "aria-label",
        `${v.title}, en ${networkNames[v.network]}, ${formatViews(v.views)} visualizaciones (se abre en otra pestaña)`
      );
      const img = card.querySelector<HTMLImageElement>(".thumb")!;
      img.hidden = !v.thumbnail;
      if (v.thumbnail && img.getAttribute("src") !== v.thumbnail) img.src = v.thumbnail;
      card.querySelector(".net")!.textContent = networkNames[v.network];
      card.querySelector(".ttl")!.textContent = v.title;
      card.querySelector("[data-v]")!.textContent = formatViews(v.views);
    }

    function hydrate(data: PublicSocial) {
      section!.querySelector("[data-followers]")!.textContent = `+${formatCount(data.followers)}`;
      section!.querySelector("[data-followed-on]")!.textContent = data.followedOn;
      section!.querySelector("[data-views]")!.textContent = formatViews(data.views);
      for (const r of rings) {
        const list = r.dataset.ring === "latest" ? data.latest : data.top;
        const current = [...r.querySelectorAll<HTMLAnchorElement>(".card")];
        if (!list.length || !current.length) continue;
        while (current.length < list.length) {
          const copy = current[0].cloneNode(true) as HTMLAnchorElement;
          r.append(copy);
          current.push(copy);
        }
        current.splice(list.length).forEach((c) => c.remove());
        current.forEach((c, k) => {
          fill(c, list[k]);
          c.style.setProperty("--a", `${(k * 360) / list.length}deg`);
        });
      }
      layout();
    }

    fetch("/api/social")
      .then((r) => (r.ok ? (r.json() as Promise<PublicSocial | null>) : null))
      .then((data) => {
        if (data && data.updatedAt !== section.dataset.updated) hydrate(data);
      })
      .catch(() => {});

    layout();
    placeSegPill();
    addEventListener("resize", () => {
      layout();
      placeSegPill();
    });
  }
</script>

<style>
  .videos {
    padding: 12vh 0;
    overflow: hidden;
  }
  .videos-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .stats {
    display: flex;
    gap: 14px 40px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .stats p {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    color: var(--soft);
    max-width: 34ch;
  }
  .stats b {
    flex: none;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .seg {
    position: relative;
    display: flex;
    padding: 5px;
    border-radius: 999px;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .seg-pill {
    position: absolute;
    top: 5px;
    bottom: 5px;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.45);
    transition:
      left 0.45s var(--ease),
      width 0.45s var(--ease);
  }
  .seg button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    color: var(--soft);
    transition: color 0.3s;
  }
  .seg button:hover {
    color: var(--ink);
  }
  .seg button[aria-pressed="true"] {
    color: #fff;
  }
  .ring-wrap {
    position: relative;
    height: 600px;
    margin-top: 24px;
    perspective: 1400px;
    display: grid;
    place-items: center;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .ring-wrap:active {
    cursor: grabbing;
  }
  .ring {
    position: relative;
    width: 210px;
    height: 373px;
    transform-style: preserve-3d;
    transform: rotateX(-4deg) rotateY(var(--ry, 0deg));
  }
  .ring[hidden] {
    display: none;
  }
  .card {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    overflow: hidden;
    transform: rotateY(var(--a)) translateZ(var(--z, 360px));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px;
    color: #fff;
    background: var(--g);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5);
    transition:
      opacity 0.4s,
      filter 0.4s,
      box-shadow 0.4s;
    backface-visibility: hidden;
    text-decoration: none;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0) 30%,
      rgba(0, 0, 0, 0) 45%,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 1;
  }
  .card > span {
    position: relative;
    z-index: 2;
  }
  .thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .net {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.9;
  }
  .ttl {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 18px;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .views {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    margin-top: 8px;
  }
  .card.back {
    opacity: 0;
    pointer-events: none;
  }
  .card.front {
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.55),
      0 0 0 2px #fff;
  }
  .card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .card.swap {
    animation: swap 0.6s var(--ease) backwards;
  }
  @keyframes swap {
    40% {
      opacity: 0;
      filter: blur(6px);
    }
  }
  /* Por encima del anillo: la tarjeta de delante no puede tapar las flechas. */
  .ring-ctrl {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .round {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 6px 16px -10px rgba(0, 0, 0, 0.35);
    transition:
      background 0.2s,
      transform 0.25s var(--spring);
  }
  .round:hover {
    background: var(--tint);
    transform: translateY(-2px);
  }
  @media (max-width: 980px) {
    .videos {
      padding: 6vh 0 8vh;
    }
    .stats b {
      font-size: 26px;
    }
    .ring-wrap {
      height: 480px;
    }
    .ring {
      width: 170px;
      height: 302px;
    }
  }
</style>
