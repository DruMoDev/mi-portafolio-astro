---
import Analytics from "../components/Analytics.astro";
import Head from "../components/Head.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string | undefined;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex, canonical, ogType, image, imageAlt, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <slot name="head" />
    <Head
      title={title}
      description={description}
      noindex={noindex}
      canonical={canonical}
      ogType={ogType}
      image={image}
      imageAlt={imageAlt}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
