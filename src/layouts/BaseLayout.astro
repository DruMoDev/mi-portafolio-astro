---
import Head from "../components/Head.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <slot />
  </body>
</html>
