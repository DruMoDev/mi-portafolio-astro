---
// Página de una guía (variante A · Recorrido del prototipo 2026-11-07-guias.html).
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import GuiaToc from "../../components/guias/GuiaToc.astro";
import GuiaGate from "../../components/guias/GuiaGate.astro";
import GuiaService from "../../components/guias/GuiaService.astro";
import GuiaRelated from "../../components/guias/GuiaRelated.astro";
import ContactModal from "../../components/ContactModal.astro";
import { siteConfig } from "../../data/site";
import { hasVideoSection } from "../../lib/social";
import { leerPasos } from "../../lib/guias/pasos";
import { LEAD_KEY } from "../../lib/guias/muro";
import { guideJsonLd } from "../../lib/guias/schema";
import { fechaCorta, minutosDeLectura } from "../../lib/guias/formato";
import { relatedGuides } from "../../lib/guias/related";
import { comprobarSustitutas } from "../../lib/guias/retirada";

export async function getStaticPaths() {
  const guias = await getCollection("guias");
  comprobarSustitutas(guias);
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia, relacionadas: relatedGuides(guias, guia) },
  }));
}

interface Props {
  guia: CollectionEntry<"guias">;
  relacionadas: CollectionEntry<"guias">[];
}

const { guia, relacionadas } = Astro.props;
const { data } = guia;
const { Content, remarkPluginFrontmatter } = await render(guia);
const pasos = leerPasos(remarkPluginFrontmatter);
const cerrada = pasos.some((p) => p.cerrado);
const minutos = minutosDeLectura(guia.body ?? "");
const [video] = data.videos;
const url = new URL(Astro.url.pathname, siteConfig.url).href;
const jsonLd = guideJsonLd({ ...data, cerrada, pasos }, url);
const { retirada } = data;
const sustituta = retirada?.sustituta
  ? (await getCollection("guias")).find((g) => g.id === retirada.sustituta)
  : undefined;
---

<BaseLayout
  title={`${data.title} · Dru Morera`}
  description={data.description}
  ogType="article"
  image={`/guias/${guia.id}/og.png`}
  imageAlt={data.title}
  jsonLd={jsonLd}
  noindex={Boolean(retirada) && !sustituta}
  canonical={sustituta ? `/guias/${sustituta.id}/` : undefined}
>
  <script is:inline slot="head" define:vars={{ key: LEAD_KEY }}>
    // Antes de pintar: con JS hay muro, y si ya dejó el email no se ve ni un instante.
    var c = document.documentElement.classList;
    c.add("js");
    try {
      if (localStorage.getItem(key)) c.add("lead-ok");
    } catch {
      // Sin almacenamiento: se pide el email.
    }
  </script>
  <Header showVideos={hasVideoSection()} base="/" />
  <main class="wrap guia">
    <GuiaToc pasos={pasos} minutos={minutos}>
      <header class="g-hero" slot="cabecera">
        {
          retirada && (
            <aside class="retirada" role="note">
              <b>
                {sustituta
                  ? "Hay una versión más nueva de esta guía."
                  : "Puede que esto ya no funcione."}
              </b>
              <span>{`${retirada.motivo} (retirada el ${fechaCorta(retirada.fecha)}).`}</span>
              {sustituta && <a href={`/guias/${sustituta.id}/`}>Ver «{sustituta.data.title}»</a>}
            </aside>
          )
        }
        <nav class="crumbs" aria-label="Migas">
          <a href="/guias">Guías</a><span aria-hidden="true">/</span><span>{data.tema}</span>
        </nav>
        <h1>{data.title}</h1>
        <p class="lede">{data.lede}</p>
        <div class="meta">
          {
            video && (
              <a class="from" href={video.url} target="_blank" rel="noopener">
                <i aria-hidden="true">
                  <Icon name="play" size={12} />
                </i>
                <span>
                  <small>Del vídeo</small>
                  <b>«{video.title}»</b>
                </span>
              </a>
            )
          }
          <span>{minutos} min de lectura</span>
          <span>
            Actualizada el <time datetime={data.updatedAt.toISOString().slice(0, 10)}
              >{fechaCorta(data.updatedAt)}</time
            >
          </span>
        </div>
      </header>
      <article class="guia-cuerpo">
        <Content />
      </article>
      <GuiaService service={data.service} />
      <GuiaRelated guias={relacionadas} />
    </GuiaToc>
    {cerrada && <GuiaGate />}
  </main>
  <Footer />
  <ContactModal />
  <template data-copiar>
    <button type="button" class="copy">
      <span class="i-copy"><Icon name="copy" size={15} /></span>
      <span class="i-ok"><Icon name="check" size={15} /></span>
      <span data-t aria-live="polite">Copiar</span>
    </button>
  </template>
</BaseLayout>

<script>
  // Botón Copiar/Copiado en cada bloque de código de la guía.
  const molde = document.querySelector<HTMLTemplateElement>("template[data-copiar]");
  document.querySelectorAll<HTMLElement>(".guia-cuerpo div.code").forEach((bloque) => {
    const pre = bloque.querySelector("pre");
    const bar = bloque.querySelector(".bar");
    const boton = molde?.content.firstElementChild?.cloneNode(true);
    if (!pre || !bar || !(boton instanceof HTMLButtonElement)) return;
    const etiqueta = bloque.dataset.label;
    boton.setAttribute("aria-label", etiqueta ? `Copiar: ${etiqueta}` : "Copiar");
    const texto = boton.querySelector<HTMLElement>("[data-t]");
    let espera = 0;
    boton.addEventListener("click", () => {
      const contenido = (pre.textContent ?? "").replace(/\n$/, "");
      navigator.clipboard.writeText(contenido).then(
        () => {
          boton.classList.add("done");
          if (texto) texto.textContent = "Copiado";
          clearTimeout(espera);
          espera = window.setTimeout(() => {
            boton.classList.remove("done");
            if (texto) texto.textContent = "Copiar";
          }, 1600);
        },
        () => {
          // Sin permiso de portapapeles: se deja el texto seleccionado para copiarlo a mano.
          const rango = document.createRange();
          rango.selectNodeContents(pre);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(rango);
        }
      );
    });
    bar.append(boton);
  });
</script>

<style is:global>
  /* Contenido de la guía: el HTML sale del Markdown, por eso los estilos son globales,
     siempre colgados de .guia. */
  .guia {
    /* El difuminado del muro se sale de la columna a propósito; que no cree scroll lateral. */
    overflow-x: clip;
    padding-bottom: 12vh;
  }
  .guia .g-hero {
    padding: 6vh 0 4vh;
    max-width: 760px;
  }
  .guia .retirada {
    display: grid;
    gap: 4px;
    margin: 0 0 22px;
    padding: 14px 16px;
    border-radius: 14px;
    background: #fff7e6;
    color: #5b4300;
    font-size: 15px;
    line-height: 1.5;
  }
  .guia .retirada b {
    font-weight: 600;
    color: #3d2d00;
  }
  .guia .retirada a {
    font-weight: 600;
    color: inherit;
  }
  .guia .crumbs {
    font-size: 14px;
    color: var(--soft);
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .guia .crumbs a {
    text-decoration: none;
  }
  .guia .crumbs a:hover {
    color: var(--ink);
  }
  .guia .g-hero h1 {
    margin-top: 18px;
    font-size: clamp(36px, 5.6vw, 64px);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .guia .lede {
    margin-top: 18px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.5;
    color: var(--soft);
    max-width: 44ch;
    text-wrap: pretty;
  }
  .guia .meta {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    font-size: 14px;
    color: var(--soft);
  }
  .guia .from {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    background: var(--tint);
    transition: background 0.2s;
  }
  .guia .from:hover {
    background: #e9ebf1;
  }
  .guia .from i {
    width: 26px;
    height: 40px;
    border-radius: 6px;
    background: linear-gradient(170deg, #2440ff, #0b1240 75%);
    display: grid;
    place-items: center;
    color: #fff;
  }
  .guia .from i svg {
    fill: #fff;
    stroke: none;
  }
  .guia .from small {
    display: block;
    font-size: 12px;
    color: var(--soft);
  }
  .guia .from b {
    font-weight: 600;
    font-size: 14px;
  }

  /* Prosa */
  .guia-cuerpo {
    font-size: 18px;
    line-height: 1.65;
    color: #2a2a2e;
  }
  .guia-cuerpo a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .guia-cuerpo a:hover {
    color: var(--accent);
  }
  .guia-cuerpo p {
    max-width: 66ch;
    text-wrap: pretty;
  }
  .guia-cuerpo :is(p, ul, ol, blockquote, .code) + :is(p, ul, ol, blockquote, .code) {
    margin-top: 18px;
  }
  .guia-cuerpo h3 {
    margin: 34px 0 10px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .guia-cuerpo ul,
  .guia-cuerpo ol {
    max-width: 64ch;
    display: grid;
    gap: 9px;
    padding-left: 0;
    list-style: none;
  }
  .guia-cuerpo ul li {
    position: relative;
    padding-left: 20px;
  }
  .guia-cuerpo ul li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .guia-cuerpo ol {
    counter-reset: n;
  }
  .guia-cuerpo ol li {
    counter-increment: n;
    position: relative;
    padding-left: 34px;
  }
  .guia-cuerpo ol li::before {
    content: counter(n);
    position: absolute;
    left: 0;
    top: 0.18em;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    display: grid;
    place-items: center;
  }
  .guia-cuerpo code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.86em;
    background: var(--tint);
    padding: 2px 6px;
    border-radius: 6px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .guia-cuerpo strong {
    color: var(--ink);
    font-weight: 600;
  }
  .guia-cuerpo blockquote {
    max-width: 62ch;
    padding: 16px 18px;
    border-radius: 14px;
    background: #fff7e6;
    color: #5b4300;
    font-size: 16px;
  }

  /* Pasos */
  .guia-cuerpo .paso {
    padding: 8px 0 54px;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .guia-cuerpo .paso:not([data-step="0"]) {
    border-top: 1px solid var(--line);
    padding-top: 48px;
  }
  .guia-cuerpo .paso-cab {
    display: flex;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 18px;
  }
  .guia-cuerpo .paso-num {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    font-size: 17px;
    line-height: 1;
    display: grid;
    place-items: center;
    transform: translateY(-4px);
  }
  .guia-cuerpo .paso h2,
  .guia-cuerpo .cierre h2 {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
    text-wrap: balance;
  }
  .guia-cuerpo .cierre {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .guia-cuerpo .cierre h2 {
    margin-bottom: 14px;
  }
  .guia-cuerpo .checklist {
    margin-top: 10px;
    padding: 26px;
    border-radius: 20px;
    background: var(--tint);
  }
  .guia-cuerpo .checklist h2 {
    font-size: 26px;
  }
  .guia-cuerpo .cierre:not(.checklist) {
    margin-top: 48px;
    font-size: 16px;
  }
  .guia-cuerpo .cierre:not(.checklist) h2 {
    font-size: 22px;
    letter-spacing: -0.015em;
  }

  /* Bloques para copiar */
  .guia-cuerpo .code {
    position: relative;
    max-width: 720px;
    border-radius: 16px;
    background: var(--tint);
  }
  .guia-cuerpo .code .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 34px;
    padding: 10px 10px 0 16px;
    font-size: 13px;
    color: var(--soft);
  }
  .guia-cuerpo .code pre {
    overflow-x: auto;
    padding: 10px 18px 18px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink);
    scrollbar-width: thin;
  }
  .guia-cuerpo .code pre code {
    background: none;
    padding: 0;
    font-size: inherit;
    overflow-wrap: normal;
  }
  .guia-cuerpo .copy {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    padding: 8px 13px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.3s var(--spring);
  }
  .guia-cuerpo .copy:hover {
    transform: translateY(-1px);
  }
  .guia-cuerpo .copy:active {
    transform: scale(0.96);
  }
  .guia-cuerpo .copy .i-ok,
  .guia-cuerpo .copy.done .i-copy {
    display: none;
  }
  .guia-cuerpo .copy.done .i-ok {
    display: inline-flex;
  }
  .guia-cuerpo .copy.done {
    background: var(--ok);
    color: #fff;
  }
  .guia-cuerpo .code.prompt {
    background: var(--ink);
    color: #fff;
  }
  .guia-cuerpo .prompt .bar {
    color: rgba(255, 255, 255, 0.72);
  }
  .guia-cuerpo .prompt pre {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.55;
    white-space: pre-wrap;
  }
  .guia-cuerpo .prompt pre code {
    font-family: inherit;
    color: inherit;
  }

  @media (max-width: 900px) {
    .guia-cuerpo .paso {
      scroll-margin-top: calc(var(--header-h) + 60px);
    }
    .guia-cuerpo .paso-num {
      width: 34px;
      height: 34px;
      font-size: 15px;
      border-radius: 10px;
    }
  }
</style>
