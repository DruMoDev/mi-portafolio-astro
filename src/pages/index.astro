---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WhoTiles from "../components/WhoTiles.astro";
import ServicesStage from "../components/ServicesStage.astro";
import VideoRing from "../components/VideoRing.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import ContactModal from "../components/ContactModal.astro";
import { Image } from "astro:assets";
import photo from "../assets/images/yo.jpg";
import { hasVideoSection } from "../lib/social";

const showVideos = hasVideoSection();

// La frase entra palabra a palabra: cada una lleva su orden para el retardo.
const lead = "Programo con IA desde hace cuatro años.".split(" ");
const rest = "Construyo para negocios, enseño a usarla y lo cuento en vídeo.".split(" ");
---

<BaseLayout>
  <Header showVideos={showVideos} />
  <main class="wrap">
    <section class="intro">
      <h1>
        {
          lead.map((w, i) => (
            <>
              <span class="w" style={`--i:${i}`}>
                {w}
              </span>{" "}
            </>
          ))
        }
        <span class="soft">
          {
            rest.map((w, i) => (
              <>
                <span class="w" style={`--i:${lead.length + i}`}>
                  {w}
                </span>{" "}
              </>
            ))
          }
        </span>
      </h1>
      <figure class="me">
        <Image
          src={photo}
          alt="Dru Morera sonriendo en una terraza"
          widths={[160, 320, 560]}
          sizes="(max-width: 980px) 72px, 280px"
          class="photo"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <b>Hola, soy Dru <span class="wave" aria-hidden="true">👋</span></b>
          <small>Roger Morera · @soydruia</small>
        </figcaption>
        <a class="bubble" href="#who-t" data-bubble>
          <span data-bubble-text>Cuéntame qué te trae por aquí</span>
          <span class="arrow-d" aria-hidden="true">↓</span>
        </a>
      </figure>
    </section>
    <WhoTiles />
    <ServicesStage showVideos={showVideos} />
    {showVideos && <VideoRing />}
    <ContactSection />
  </main>
  <Footer />
  <ContactModal />
</BaseLayout>

<script>
  // Si en un rato nadie elige en "¿Qué te trae por aquí?", el bocadillo propone ver los servicios.
  // No mueve la página solo: solo cambia la invitación.
  const bubble = document.querySelector<HTMLAnchorElement>("[data-bubble]");
  const text = bubble?.querySelector<HTMLElement>("[data-bubble-text]");
  let idle = 0;
  const reset = () => {
    clearTimeout(idle);
    idle = window.setTimeout(() => {
      if (!bubble || !text || document.querySelector('.tile[aria-pressed="true"]')) return;
      text.textContent = "¿Aún dudas? Mira mis servicios";
      bubble.href = "#servicios";
      bubble.classList.add("swap");
    }, 12000);
  };
  addEventListener("who:change", () => clearTimeout(idle));
  reset();
</script>

<style>
  .intro {
    padding: 8vh 0 6vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 48px;
  }
  .me {
    position: relative;
    width: 280px;
    margin: 0;
    animation: me-in 0.9s var(--ease) 0.85s backwards;
  }
  .photo {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: 72% 30%;
    border-radius: 28px;
    transform: rotate(2deg);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45);
  }
  figcaption {
    position: absolute;
    left: -28px;
    bottom: 22px;
    padding: 12px 16px;
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.05),
      0 16px 34px -14px rgba(0, 0, 0, 0.35);
    animation: me-tag 0.7s var(--spring) 1.35s backwards;
  }
  figcaption b {
    display: block;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  figcaption small {
    font-size: 13px;
    color: var(--soft);
  }
  .wave {
    display: inline-block;
    transform-origin: 70% 80%;
    animation: wave 1.4s ease-in-out 1.7s 2;
  }
  @keyframes me-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
  }
  @keyframes me-tag {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
  }
  @keyframes wave {
    0%,
    60%,
    100% {
      transform: none;
    }
    15%,
    45% {
      transform: rotate(16deg);
    }
    30% {
      transform: rotate(-8deg);
    }
  }
  @media (max-width: 980px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-top: 4vh;
    }
    .me {
      width: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .photo {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      transform: none;
      box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.45);
    }
    figcaption {
      position: static;
      padding: 0;
      background: none;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .me,
    figcaption,
    .wave,
    .w,
    .bubble,
    .arrow-d {
      animation: none;
    }
  }
  h1 {
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 500;
    max-width: 21ch;
  }
  h1 .soft {
    color: var(--soft);
  }
  /* Entrada: cada palabra sube y se enfoca, una detrás de otra. */
  .w {
    display: inline-block;
    animation: word 0.9s var(--ease) backwards;
    animation-delay: calc(0.1s + var(--i) * 0.035s);
  }
  @keyframes word {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.4em);
    }
  }
  /* Tu foto "habla": el bocadillo invita a elegir abajo. */
  .bubble {
    position: absolute;
    right: -14px;
    bottom: -64px;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    padding: 12px 16px;
    border-radius: 18px 4px 18px 18px;
    background: var(--ink);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    box-shadow: 0 16px 34px -14px rgba(0, 0, 0, 0.5);
    animation: bubble 0.7s var(--spring) 1.9s backwards;
    transition: background 0.25s;
  }
  .bubble:hover {
    background: var(--accent);
  }
  .bubble::before {
    content: "";
    position: absolute;
    right: 30px;
    top: -7px;
    width: 14px;
    height: 14px;
    background: inherit;
    transform: rotate(45deg);
    border-radius: 2px;
  }
  .arrow-d {
    display: inline-block;
    animation: bob 1.6s ease-in-out 2.6s infinite;
  }
  .bubble.swap span:first-child {
    animation: swap-text 0.5s var(--ease);
  }
  @keyframes bubble {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(0.6);
      transform-origin: 80% 0;
    }
  }
  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }
  @media (max-width: 980px) {
    .me {
      flex-wrap: wrap;
    }
    .bubble {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: 4px;
      white-space: normal;
      font-size: 14px;
      border-radius: 4px 18px 18px 18px;
    }
    .bubble::before {
      right: auto;
      left: 26px;
    }
  }
  @keyframes swap-text {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
