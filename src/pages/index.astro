---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WhoTiles from "../components/WhoTiles.astro";
import ServicesStage from "../components/ServicesStage.astro";
import VideoRing from "../components/VideoRing.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import ContactModal from "../components/ContactModal.astro";
import { Image } from "astro:assets";
import photo from "../assets/images/yo.jpg";
import { hasVideoSection } from "../lib/social";

const showVideos = hasVideoSection();
---

<BaseLayout>
  <Header showVideos={showVideos} />
  <main class="wrap">
    <section class="intro">
      <h1>
        Programo con IA desde hace cuatro años. <span
          >Construyo para negocios, enseño a usarla y lo cuento en vídeo.</span
        >
      </h1>
      <figure class="me">
        <Image
          src={photo}
          alt="Dru Morera sonriendo en una terraza"
          widths={[160, 320, 560]}
          sizes="(max-width: 980px) 72px, 280px"
          class="photo"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <b>Hola, soy Dru <span class="wave" aria-hidden="true">👋</span></b>
          <small>Roger Morera · @soydruia</small>
        </figcaption>
      </figure>
    </section>
    <WhoTiles />
    <ServicesStage showVideos={showVideos} />
    {showVideos && <VideoRing />}
    <ContactSection />
  </main>
  <Footer />
  <ContactModal />
</BaseLayout>

<style>
  .intro {
    padding: 8vh 0 6vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 48px;
  }
  .me {
    position: relative;
    width: 280px;
    margin: 0;
    animation: me-in 0.9s var(--ease) 0.15s backwards;
  }
  .photo {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: 72% 30%;
    border-radius: 28px;
    transform: rotate(2deg);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.45);
  }
  figcaption {
    position: absolute;
    left: -28px;
    bottom: 22px;
    padding: 12px 16px;
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.05),
      0 16px 34px -14px rgba(0, 0, 0, 0.35);
    animation: me-tag 0.7s var(--spring) 0.7s backwards;
  }
  figcaption b {
    display: block;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  figcaption small {
    font-size: 13px;
    color: var(--soft);
  }
  .wave {
    display: inline-block;
    transform-origin: 70% 80%;
    animation: wave 1.4s ease-in-out 1.3s 2;
  }
  @keyframes me-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
  }
  @keyframes me-tag {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
  }
  @keyframes wave {
    0%,
    60%,
    100% {
      transform: none;
    }
    15%,
    45% {
      transform: rotate(16deg);
    }
    30% {
      transform: rotate(-8deg);
    }
  }
  @media (max-width: 980px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-top: 4vh;
    }
    .me {
      order: -1;
      width: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .photo {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      transform: none;
      box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.45);
    }
    figcaption {
      position: static;
      padding: 0;
      background: none;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .me,
    figcaption,
    .wave {
      animation: none;
    }
  }
  h1 {
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 500;
    max-width: 21ch;
  }
  h1 span {
    color: var(--soft);
  }
</style>
