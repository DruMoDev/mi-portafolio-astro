---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada · Dru Morera" noindex>
  <main class="wrap nf">
    <p class="code">404</p>
    <h1 class="sec">Esta página no existe.</h1>
    <p class="sub">
      Puede que el enlace sea antiguo. Lo que buscas seguramente está en la portada.
    </p>
    <a class="cta" href="/">Ir a la portada</a>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }
  .code {
    font-size: 15px;
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }
  h1 {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .sub {
    font-size: 18px;
    color: var(--soft);
    max-width: 44ch;
    line-height: 1.5;
  }
</style>
