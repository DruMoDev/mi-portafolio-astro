{
  "name": "mi-portafolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "social:sync": "node --experimental-strip-types --no-warnings scripts/sync-social.mjs && prettier --write src/data/social.json",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{ts,js,astro,json,md,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,astro,json,md,css}\"",
    "type-check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/astro": "^0.562.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.155.0"
  }
}
